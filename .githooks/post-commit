#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# FantasyDisk auto-land hook (post-commit)
#
# Политика (директива пользователя 2026-07-03): КАЖДЫЙ чат/агент сразу лендит
# свой коммит в dev — локально и на origin — но ТОЛЬКО если коммит "зелёный"
# (проходит runtime smoke). Красный коммит остаётся на ветке чата и ждёт
# следующего зелёного.
#
# Безопасность под параллельным флотом (см. memory про concurrent rebase/reset):
#   * Живая ветка чата НЕ трогается: ленд идёт ff-пушем, а при расхождении —
#     merge в ОДНОРАЗОВОМ временном worktree. Рабочее дерево агента неизменно.
#   * merge-модель (не rebase) → исходные SHA сохраняются, дублей на dev нет.
#   * Всё крутится в фоне под per-repo flock — коммит агента возвращается мгновенно.
#
# Выключатели (env):
#   FSD_NO_AUTOLAND=1        — полностью отключить автоленд
#   FSD_AUTOLAND_SKIP_SMOKE=1 — лендить без smoke (ОПАСНО, для отладки)
#   FSD_AUTOLAND_ACTIVE=1    — внутренний re-entry guard (не ставить вручную)
# ---------------------------------------------------------------------------
set -uo pipefail

[ "${FSD_NO_AUTOLAND:-0}" = "1" ]      && exit 0
[ "${FSD_AUTOLAND_ACTIVE:-0}" = "1" ]  && exit 0   # не лендить коммиты, сделанные самим хуком

GITDIR="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
COMMONDIR="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
# главный чекаут (там лежат tools/, .githooks/) — родитель git-common-dir
MAIN_REPO="$(cd "$COMMONDIR/.." && pwd)"

# не вмешиваемся в служебные операции с историей
for m in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD BISECT_LOG REVERT_HEAD; do
	[ -e "$GITDIR/$m" ] && exit 0
done

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || exit 0
[ "$BRANCH" = "HEAD" ] && exit 0            # detached (QA-worktree) — нечего лендить
SHA="$(git rev-parse HEAD 2>/dev/null)"     || exit 0
WT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

LOG="$COMMONDIR/autoland.log"
LOCKDIR="$COMMONDIR/autoland.lock.d"

# ---- фоновая часть: коммит агента возвращается сразу -----------------------
(
	export FSD_AUTOLAND_ACTIVE=1
	# КРИТИЧНО: git экспортит хуку GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE/GIT_PREFIX,
	# указывающие на worktree ЭТОГО чата. Они перекрывают `git -C ...` и заставляют
	# кросс-worktree команды (worktree add, merge, local-dev ff) работать в контексте
	# чата. Сбрасываем, чтобы `-C <path>` реально выбирал нужный репозиторий.
	unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_REFLOG_ACTION \
	      GIT_QUARANTINE_PATH GIT_PUSH_CERT_NONCE GIT_INTERNAL_GETTEXT_TEST_HARNESS 2>/dev/null
	exec >>"$LOG" 2>&1
	stamp() { date "+%Y-%m-%dT%H:%M:%S"; }
	# portable mutex (на macOS нет flock): атомарный mkdir + защита от stale-lock.
	# Сериализует лендинги по всему репо — все worktree делят COMMONDIR.
	acquired=0
	for _ in $(seq 1 600); do            # до ~10 мин ожидания слота
		if mkdir "$LOCKDIR" 2>/dev/null; then
			echo $$ >"$LOCKDIR/pid"; acquired=1; break
		fi
		# stale-lock: держатель мёртв → снимаем
		lpid="$(cat "$LOCKDIR/pid" 2>/dev/null)"
		if [ -n "$lpid" ] && ! kill -0 "$lpid" 2>/dev/null; then
			rm -rf "$LOCKDIR"; continue
		fi
		sleep 1
	done
	if [ "$acquired" != "1" ]; then
		echo "[$(stamp)] lock timeout — ленд ${SHA:0:9} пропущен (ретрай на след. коммите)"; exit 0
	fi
	trap 'rm -rf "$LOCKDIR"' EXIT
	echo "[$(stamp)] autoland: branch=$BRANCH sha=${SHA:0:9} wt=$WT"

	# 1) GREEN GATE — runtime smoke (до 2 попыток: защита от флаки-красных)
	if [ "${FSD_AUTOLAND_SKIP_SMOKE:-0}" != "1" ]; then
		GODOT_BIN="${GODOT_BIN:-/private/tmp/fsd_godot_sem/bin/fdengine}"
		[ -x "$GODOT_BIN" ] || GODOT_BIN="$HOME/Downloads/Godot.app/Contents/MacOS/Godot"
		green=0
		for attempt in 1 2; do
			if GODOT_BIN="$GODOT_BIN" FSD_GODOT_SLOTS="${FSD_GODOT_SLOTS:-1}" \
				python3 "$MAIN_REPO/tools/godot_gate.py" --headless \
				--path "$WT" --script res://tests/runtime_smoke_test.gd; then
				green=1; break
			fi
			echo "[$(stamp)] smoke attempt $attempt RED"
		done
		if [ "$green" != "1" ]; then
			echo "[$(stamp)] SMOKE RED → НЕ лендим ${SHA:0:9} (ветка $BRANCH ждёт зелёного)"
			exit 0
		fi
	fi

	# 2) LAND → origin/dev, с bounded-retry на push-гонки (в т.ч. с отдельными codex-клонами)
	landed=0
	for attempt in 1 2 3 4 5; do
		git -C "$WT" fetch -q origin dev 2>/dev/null || true
		# уже на origin/dev? (мог залендить параллельный лейн)
		if git -C "$WT" merge-base --is-ancestor "$SHA" origin/dev 2>/dev/null; then
			landed=1; break
		fi
		if git -C "$WT" merge-base --is-ancestor origin/dev "$SHA" 2>/dev/null; then
			# чистый fast-forward — линейная история, ветку чата не трогаем
			if git -C "$WT" push -q origin "$SHA":refs/heads/dev 2>/dev/null; then
				echo "[$(stamp)] landed (ff, try $attempt) ${SHA:0:9} → origin/dev"; landed=1; break
			fi
		else
			# расхождение → merge в ОДНОРАЗОВОМ detached temp worktree (дерево агента неизменно)
			TMP="$(mktemp -d "${TMPDIR:-/tmp}/fsd-land.XXXXXX")"
			ODEV="$(git -C "$MAIN_REPO" rev-parse origin/dev 2>/dev/null)"
			conflict=0
			if [ -n "$ODEV" ] && git -C "$MAIN_REPO" worktree add -q --detach "$TMP" "$ODEV" 2>/dev/null; then
				if git -C "$TMP" merge --no-edit "$SHA" 2>/dev/null; then
					if git -C "$TMP" push -q origin "HEAD":refs/heads/dev 2>/dev/null; then
						echo "[$(stamp)] landed (merge, try $attempt) ${SHA:0:9} → origin/dev"; landed=1
					fi
				else
					git -C "$TMP" merge --abort 2>/dev/null
					conflict=1
					echo "[$(stamp)] MERGE CONFLICT ${SHA:0:9} ветка $BRANCH — нужен ручной ленд"
				fi
				git -C "$MAIN_REPO" worktree remove --force "$TMP" 2>/dev/null
			else
				rm -rf "$TMP"
			fi
			git -C "$MAIN_REPO" worktree prune 2>/dev/null
			[ "$conflict" = "1" ] && break   # конфликт ретраем не лечится
			[ "$landed" = "1" ] && break
		fi
		sleep 2   # origin/dev двинулся под нами — обновимся и повторим
	done
	[ "$landed" != "1" ] && echo "[$(stamp)] LAND не удался за 5 попыток ${SHA:0:9} — ретрай на след. коммите"

	# 3) LOCAL dev — best-effort ff в чекауте, где dev выписан (не мешаем живому редактору)
	DEVWT="$(git -C "$MAIN_REPO" worktree list --porcelain \
		| awk '/^worktree /{w=substr($0,10)} /^branch refs\/heads\/dev$/{print w}' | head -1)"
	if [ -n "$DEVWT" ] && [ -d "$DEVWT" ]; then
		if [ -z "$(git -C "$DEVWT" status --porcelain 2>/dev/null)" ]; then
			git -C "$DEVWT" fetch -q origin dev 2>/dev/null || true
			if git -C "$DEVWT" merge --ff-only origin/dev 2>/dev/null; then
				echo "[$(stamp)] local dev ff → origin/dev в $DEVWT"
			fi
		else
			echo "[$(stamp)] local dev пропущен: $DEVWT грязный (живая работа) — подтянется вручную"
		fi
	fi
	echo "[$(stamp)] autoland done ${SHA:0:9}"
) >/dev/null 2>&1 </dev/null &
disown 2>/dev/null || true
exit 0
