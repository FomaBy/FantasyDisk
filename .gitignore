.DS_Store
.godot/
build/
releases/
*.swp

# Scratch image-gen / temp work dir
tmp/

# In-game feedback Discord webhook (секрет, не коммитить)
feedback_webhook.cfg

# Feedback intake state (дедуп, локальный)
tools/.feedback_intake_state.json

# Release Discord webhook (секрет, не коммитить)
release_webhook.cfg

# Telegram-канал релизов (секрет): env FANTASYDISK_RELEASE_TG_CHANNEL или этот файл
release_tg.cfg

# Любые локальные секрет-конфиги *.cfg — кроме коммитируемых ниже
*.cfg
!export_presets.cfg
!*.cfg.example

# Telethon session релиза (секрет)
*.session
fantasydisk_release.session

# OS / редакторы
Thumbs.db
desktop.ini
.idea/
.vscode/
*.tmp

# Python tooling/test caches must never dirty quality-gate worktrees.
__pycache__/
*.py[cod]

# Build-артефакты (помимо build/ и releases/ — на всякий случай)
*.dmg
*.exe

# Локальные секреты-окружения (OpenAI key и пр.)
.env
*.env

# Локальные токены/API secrets, включая PixelLab bearer token
*.token
*.secret
auth_header.txt
pixellab_auth_header.txt

# graphify: local generated knowledge graph, not committed (regenerate via
# `python ".claude/skills/graphify/run.py" extract . --code-only`)
graphify-out/
.claude/skills/graphify/.venv/
