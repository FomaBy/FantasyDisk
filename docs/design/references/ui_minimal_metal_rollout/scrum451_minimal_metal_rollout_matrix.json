  "responsive_targets": {
    "1280x720": {
      "scale_policy": "Prefer existing compact layouts; do not reduce content inset below scaled content_rect + 8px runtime reserve.",
      "shell_max": "Keep modal shells within 92% viewport width and 88% viewport height; scroll inner panels before shrinking margins.",
      "card_policy": "Use fewer columns or horizontal scroll for cards before squeezing text onto frame rails."
    },
    "1920x1080": {
      "scale_policy": "Base design target. Use source metadata ratios and 9-slice center stretch for generic surfaces.",
      "shell_max": "Large shells may use 70-82% viewport width depending on screen density.",
      "card_policy": "Use native card proportions and current screen-specific layout density."
    },
    "2560x1440": {
      "scale_policy": "Increase spacing and content columns before increasing text size; rails/rubies remain visually thin.",
      "shell_max": "Cap central shells around 1800-1960px unless the existing screen owns a wider canvas.",
      "card_policy": "Cards may gain whitespace but should keep content centered inside safe rect."
    }
  },
