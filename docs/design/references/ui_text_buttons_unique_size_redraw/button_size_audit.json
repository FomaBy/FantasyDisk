  "excluded_groups": [
    {
      "group": "Hero carousel thumbnails / TextureButton slots",
      "count": "dynamic 9 slots",
      "reason": "icon/portrait card hit areas; not text buttons; child labels are adjacent/inside carousel content and use authored HS4 frame contract"
    },
    {
      "group": "Weapon select cards",
      "count": "3 cards",
      "reason": "active SCRUM-562 overlap; cards intentionally use card/text-field styling, not action button kit"
    },
    {
      "group": "Shop item buttons",
      "count": "4 wall slots",
      "reason": "icon/product hit areas on shop backdrop; no text label on button body"
    },
    {
      "group": "Reward, elite artifact, level-up reward, event, attribute offer cards",
      "count": "multiple 3-card groups",
      "reason": "full-card information choices with child labels; excluded from text-button kit to avoid squeezing paragraphs into button frames"
    },
    {
      "group": "Progression nodes / skill tree circular buttons",
      "count": "dynamic",
      "reason": "circular node frames; text belongs outside/tooltip, not a rectangular action button"
    },
    {
      "group": "Combat LevelUpPlusButton / UpgradeFabButton / ascension +/- / carousel arrows",
      "count": "small controls",
      "reason": "icon/symbol-only controls; need icon/square/FAB family, not text-button family"
    },
    {
      "group": "Glossary term underline buttons",
      "count": "dynamic",
      "reason": "inline text affordances; visual state is underline/tooltip, not framed text button"
    }
  ],
