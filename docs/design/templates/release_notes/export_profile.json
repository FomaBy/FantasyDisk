    {"id": "release_date", "purpose": "release date", "rect": [910, 125, 330, 125], "max_lines": 1},
    {"id": "key_changes", "purpose": "key changes", "rect": [125, 575, 500, 425], "max_lines": 12},
    {"id": "fixed_bugs", "purpose": "fixed bugs", "rect": [725, 575, 500, 425], "max_lines": 12}
  ],
  "outputs": {
    "publishable": "final/final.png",
    "debug_overlay": "qa/final.debug.png",
    "planning_guide": "qa/layout.guide.png",
    "render_report": "qa/render_report.json",
