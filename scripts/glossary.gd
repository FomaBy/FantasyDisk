static func term_ids() -> Array:
	var ids := TERMS.keys()
	ids.sort()
	return ids


static func definition(term_id: String) -> Dictionary:
	return (TERMS.get(term_id, {}) as Dictionary).duplicate(true)


static func name(term_id: String) -> String:
	return str(definition(term_id).get("name", term_id))


static func description(term_id: String) -> String:
	return str(definition(term_id).get("desc", ""))


static func is_valid_term(term_id: String) -> bool:
	var entry := definition(term_id)
	return str(entry.get("name", "")) != "" and str(entry.get("desc", "")) != ""
