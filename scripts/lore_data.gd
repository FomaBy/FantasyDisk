# Спойлер-строка про Исток для записи «Владыки Разлома» — добавляется только
# после встречи игрока с секретным боссом (META_PROGRESSION discovery/defeat).
const SECRET_LORD_LINE := "На дне Разлома, ниже всех витков, дышит то, что присылает Владык. Хранители зовут его Истоком. Ты видел его — и вернулся."


static func intro_slides() -> Array:
	return INTRO_SLIDES


static func chronicle_entries() -> Array:
	return CHRONICLE


static func boss_lore(boss_id: String) -> Dictionary:
	return BOSS_LORE.get(boss_id, {})


static func boss_intro_line(boss_id: String) -> String:
	return str(boss_lore(boss_id).get("intro", ""))


static func boss_doom_line(boss_id: String) -> String:
	return str(boss_lore(boss_id).get("doom", ""))


static func elite_lore(elite_id: String) -> String:
	return str(ELITE_LORE.get(elite_id, ""))


static func class_origin(character_id: String) -> String:
	return str(CLASS_ORIGIN.get(character_id, ""))


static func victory_line(rift_goes_deeper: bool) -> String:
	return VICTORY_LINE_DEEPER if rift_goes_deeper else VICTORY_LINE


static func defeat_line() -> String:
	return DEFEAT_LINE
