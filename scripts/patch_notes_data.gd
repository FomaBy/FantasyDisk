static func all_entries() -> Array:
	return PATCH_NOTES


static func latest_version() -> String:
	return str(PATCH_NOTES[0]["version"]) if not PATCH_NOTES.is_empty() else "0.0.0"


static func entries_since(last_seen_version: String) -> Array:
	# Записи новее last_seen_version (для бейджа новой версии после обновления).
	var result := []
	for entry in PATCH_NOTES:
		if _version_greater(str(entry["version"]), last_seen_version):
			result.append(entry)
	return result


static func has_new_since(last_seen_version: String) -> bool:
	return not entries_since(last_seen_version).is_empty()


static func _version_greater(a: String, b: String) -> bool:
	# Сравнение semver-подобных строк «MAJOR.MINOR.PATCH»; нечисловые части (как
	# «в разработке») игнорируются как 0. Возвращает a > b.
	var pa := _version_parts(a)
	var pb := _version_parts(b)
	for i in range(3):
		if pa[i] != pb[i]:
			return pa[i] > pb[i]
	return false


static func _version_parts(v: String) -> Array:
	var parts := [0, 0, 0]
	var split := v.split(".")
	for i in range(min(split.size(), 3)):
		parts[i] = int(split[i]) if str(split[i]).is_valid_int() else 0
	return parts
