# Required server secrets. Leave blank in source control and inject independent
# values through the staging/production host's secret store.
FEEDBACK_TOKEN_SECRET=
FEEDBACK_LOG_SALT=
FEEDBACK_DISCORD_WEBHOOK=

# Durable single-replica state and internal listener.
FEEDBACK_DATABASE_PATH=/data/feedback_proxy.sqlite3
FEEDBACK_LISTEN_HOST=0.0.0.0
FEEDBACK_LISTEN_PORT=8080

# Upstream, proxy, admission, and process bounds.
FEEDBACK_UPSTREAM_TIMEOUT=10
FEEDBACK_TRUSTED_PROXY_CIDRS=
FEEDBACK_SESSION_GLOBAL_LIMIT=500
FEEDBACK_GLOBAL_LIMIT=120
FEEDBACK_MAX_WORKERS=24
FEEDBACK_READ_TIMEOUT=15
FEEDBACK_LOG_LEVEL=INFO
