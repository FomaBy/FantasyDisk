extends SceneTree

# FAN-3924 (FD17): characterization of the pure derived-stat model behind the
# ProgressionData facade. Every live class/weapon variant is compared through
# the full result dictionary at base, zero, extreme and stacked-upgrade inputs,
# both against the extracted model and against a 205-record fixture generated
# from the accepted pre-extraction base. The same matrix also exercises the
# no-weapon/missing-key path and direct defense/sustain/crit helpers, so a
# refactor cannot silently drop an output or move a cap while keeping only the
# happy-path damage values green.
#
# Run: python3 tools/godot_gate.py --headless --path . \
#   --script res://tests/derived_stats_model_characterization_test.gd

const PD := preload("res://scripts/progression_data.gd")
const DerivedStats := preload("res://scripts/progression/derived_stats.gd")

const EXPECTED_CLASS_COUNT := 17
const EXPECTED_VARIANT_COUNT := 51
const STAT_IDS := ["strength", "agility", "intelligence", "perception", "energy", "knowledge", "endurance", "leadership"]
const DERIVED_KEYS := [
	"damage", "magic_damage", "attack_speed", "attack_cadence_multiplier", "crit_chance",
	"crit_damage_multiplier", "move_speed", "raw_dodge", "dodge", "raw_defense", "defense",
	"health_point", "attack_range", "attack_area_multiplier", "aoe_radius", "pickup_radius",
	"dot_damage", "dot_speed", "projectile_speed", "aura_radius", "support_multiplier",
	"knockback_power", "summon_amount", "leadership", "absorb", "regeneration",
	"vampiric_chance", "vampiric_amount", "ultimate_multiplier",
]


func _initialize() -> void:
	var errors: Array = []
	var class_ids: Array = PD.character_ids()
	if class_ids.size() != EXPECTED_CLASS_COUNT:
		errors.append("character_ids: expected %d classes, got %d" % [EXPECTED_CLASS_COUNT, class_ids.size()])
	var variants := 0
	var zero_stats := _flat_stats(0.0)
	var extreme_stats := _flat_stats(500.0)
	var upgrade_stats := _upgrade_stats()
	var upgrade_modifiers := _upgrade_modifiers()

	for character_id_raw in class_ids:
		var character_id := str(character_id_raw)
		var base_stats: Dictionary = PD.base_stats(character_id)
		for weapon_id_raw in PD.weapon_ids(character_id):
			var weapon_id := str(weapon_id_raw)
			variants += 1
			var config: Dictionary = PD.weapon(character_id, weapon_id)
			var label := "%s/%s" % [character_id, weapon_id]
			_compare_pair(errors, label + "/base", base_stats, {}, config)
			_compare_pair(errors, label + "/zero", zero_stats, {}, config)
			_compare_pair(errors, label + "/extreme", extreme_stats, {}, config)
			_compare_pair(errors, label + "/upgrades", upgrade_stats, upgrade_modifiers, config)
			if errors.size() > 20:
				break
		if errors.size() > 20:
			break
	if variants != EXPECTED_VARIANT_COUNT:
		errors.append("weapon variants: expected %d, got %d" % [EXPECTED_VARIANT_COUNT, variants])

	# Missing class/weapon keys still return the complete dictionary and finite
	# values. This is the save/load-safe fallback used by callers without a weapon.
	_compare_pair(errors, "missing_inputs", {}, {}, {})
	_check_helper_parity(errors)
	_check_golden(errors)

	if not errors.is_empty():
		for error in errors:
			push_error("Derived stats characterization: %s" % error)
		push_error("Derived stats characterization test: %d errors." % errors.size())
		quit(1)
		return
	print("Derived stats characterization test passed (%d classes, %d weapon variants, full dictionaries and edge helpers matched)." % [class_ids.size(), variants])
	quit(0)


func _compare_pair(errors: Array, label: String, stats: Dictionary, run_modifiers: Dictionary, config: Dictionary) -> void:
	var facade_result: Dictionary = PD.derived_parameters(stats, run_modifiers, config)
	var character_id := str(config.get("character_id", ""))
	var model_result: Dictionary = DerivedStats.derived_parameters(stats, run_modifiers, config, _model_context(character_id, stats))
	if _canonical(facade_result) != _canonical(model_result):
		errors.append("%s: facade/model dictionary mismatch\n  facade=%s\n  model=%s" % [label, _canonical(facade_result), _canonical(model_result)])
	if facade_result.size() != DERIVED_KEYS.size():
		errors.append("%s: expected %d derived keys, got %d" % [label, DERIVED_KEYS.size(), facade_result.size()])
	for key in DERIVED_KEYS:
		if not facade_result.has(key):
			errors.append("%s: missing derived key '%s'" % [label, key])
			continue
		if not is_finite(float(facade_result[key])):
			errors.append("%s: derived key '%s' is not finite (%s)" % [label, key, facade_result[key]])


func _model_context(character_id: String, stats: Dictionary) -> Dictionary:
	var base_stats: Dictionary = PD.base_stats(character_id) if character_id != "" else {}
	var class_scalars: Variant = PD.CLASS_LEVEL_STAT_GROWTH_SCALARS.get(character_id, 1.0)
	var agility := float(stats.get("agility", 0.0))
	if character_id != "":
		agility = DerivedStats._scaled_stat_growth(class_scalars, "agility", agility, base_stats)
	var trait_config: Dictionary = PD.class_trait(character_id)
	return {
		"character_id": character_id,
		"base_stats": base_stats,
		"class_stat_growth_scalars": class_scalars,
		"magic_bonus_effectiveness": maxf(float(trait_config.get("magic_bonus_effectiveness", 1.0)), 1.0),
		"pickup_radius_multiplier": maxf(float(trait_config.get("pickup_radius_multiplier", 1.0)), 1.0),
		"generic_sustain_blocked": PD.class_blocks_generic_sustain(character_id),
		"crit_profile": PD.class_crit_profile(character_id, DerivedStats.ordinary_crit_chance_cap(agility)),
		"trait_config": trait_config,
	}


func _check_helper_parity(errors: Array) -> void:
	for raw_value in [-100.0, 0.0, 0.25, 2.0, 1000000.0]:
		if not is_equal_approx(PD.effective_defense(raw_value), DerivedStats.effective_defense(raw_value)):
			errors.append("effective_defense(%s) facade/model mismatch" % raw_value)
		if not is_equal_approx(PD.effective_dodge(raw_value), DerivedStats.effective_dodge(raw_value)):
			errors.append("effective_dodge(%s) facade/model mismatch" % raw_value)
		if not is_equal_approx(PD.effective_vampiric_chance(raw_value), DerivedStats.effective_vampiric_chance(raw_value)):
			errors.append("effective_vampiric_chance(%s) facade/model mismatch" % raw_value)
	for knowledge in [-100.0, 0.0, 4.0, 1000000.0]:
		for flat_value in [-100.0, 0.0, 1.0, 1000000.0]:
			if not is_equal_approx(PD.effective_regeneration(knowledge, flat_value), DerivedStats.effective_regeneration(knowledge, flat_value)):
				errors.append("effective_regeneration(%s,%s) facade/model mismatch" % [knowledge, flat_value])
			if not is_equal_approx(PD.effective_vampiric_amount(knowledge, flat_value), DerivedStats.effective_vampiric_amount(knowledge, flat_value)):
				errors.append("effective_vampiric_amount(%s,%s) facade/model mismatch" % [knowledge, flat_value])
	for agility in [-100.0, 0.0, 25.0, 500.0]:
		if not is_equal_approx(PD.ordinary_crit_chance_cap(agility), DerivedStats.ordinary_crit_chance_cap(agility)):
			errors.append("ordinary_crit_chance_cap(%s) facade/model mismatch" % agility)
			if not is_equal_approx(PD.effective_crit_damage_multiplier(agility, 100.0), DerivedStats.effective_crit_damage_multiplier(agility, 100.0)):
				errors.append("effective_crit_damage_multiplier(%s) facade/model mismatch" % agility)


func _check_golden(errors: Array) -> void:
	var golden := _parse_golden(errors)
	var seen := {}
	var zero_stats := _flat_stats(0.0)
	var extreme_stats := _flat_stats(500.0)
	var upgrade_stats := _upgrade_stats()
	var upgrade_modifiers := _upgrade_modifiers()
	for character_id_raw in PD.character_ids():
		var character_id := str(character_id_raw)
		var base_stats: Dictionary = PD.base_stats(character_id)
		for weapon_id_raw in PD.weapon_ids(character_id):
			var weapon_id := str(weapon_id_raw)
			var config: Dictionary = PD.weapon(character_id, weapon_id)
			var label := "%s/%s" % [character_id, weapon_id]
			_check_golden_record(errors, golden, seen, "base", label, PD.derived_parameters(base_stats, {}, config))
			_check_golden_record(errors, golden, seen, "zero", label, PD.derived_parameters(zero_stats, {}, config))
			_check_golden_record(errors, golden, seen, "extreme", label, PD.derived_parameters(extreme_stats, {}, config))
			_check_golden_record(errors, golden, seen, "upgrades", label, PD.derived_parameters(upgrade_stats, upgrade_modifiers, config))
	_check_golden_record(errors, golden, seen, "missing", "none", PD.derived_parameters({}, {}, {}))
	for key in golden:
		if not seen.has(key):
			errors.append("%s: stale fixture line without a live case" % key)


func _check_golden_record(errors: Array, golden: Dictionary, seen: Dictionary, scenario: String, label: String, result: Dictionary) -> void:
	var key := "%s %s" % [scenario, label]
	seen[key] = true
	if not golden.has(key):
		errors.append("%s: no fixture line (regenerate GOLDEN from the accepted base)" % key)
		return
	var actual := _canonical(result)
	if str(golden[key]) != actual:
		errors.append("%s: result drifted\n    expected %s\n    actual   %s" % [key, golden[key], actual])


func _parse_golden(errors: Array) -> Dictionary:
	var golden := {}
	for line_raw in GOLDEN.split("\n"):
		var line := str(line_raw).strip_edges()
		if line == "":
			continue
		var first := line.find(" ")
		var second := line.find(" ", first + 1)
		if first <= 0 or second <= first:
			errors.append("GOLDEN: malformed fixture line '%s'" % line)
			continue
		var key := line.substr(0, second)
		if golden.has(key):
			errors.append("GOLDEN: duplicate fixture line for %s" % key)
		golden[key] = line.substr(second + 1)
	if golden.is_empty():
		errors.append("GOLDEN: fixture is empty")
	return golden


func _flat_stats(value: float) -> Dictionary:
	var stats := {}
	for stat_id in STAT_IDS:
		stats[stat_id] = value
	return stats


func _upgrade_stats() -> Dictionary:
	var stats := {}
	for stat_id in STAT_IDS:
		stats[stat_id] = 25.0
	return stats


func _upgrade_modifiers() -> Dictionary:
	return {
		"damage_multiplier": pow(1.15, 3.0),
		"magic_damage_multiplier": pow(1.15, 3.0),
		"attack_speed_multiplier": pow(1.12, 3.0),
		"aoe_radius_multiplier": pow(1.15, 3.0),
		"move_speed_multiplier": pow(1.10, 3.0),
		"damage_flat": 12.0,
		"dot_damage_flat": 9.0,
		"crit_chance_flat": 0.21,
		"crit_damage_flat": 1.05,
		"max_health_flat": 54.0,
		"defense_flat": 0.30,
		"dodge_flat": 0.24,
		"regeneration_flat": 3.9,
		"ultimate_flat": 0.36,
		"vampiric_chance_flat": 0.15,
		"vampiric_amount_flat": 2.4,
	}


func _canonical(value) -> String:
	return JSON.stringify(value, "", true, true)


