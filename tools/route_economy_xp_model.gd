				{"type": "elite", "stage": 2},
				{"type": "battle", "stage": 3},
				{"type": "rest", "stage": 4},
				{"type": "battle", "stage": 5},
				{"type": "upgrade", "stage": 6},
				{"type": "battle", "stage": 7},
				{"type": "boss", "stage": 8},
			],
		},
		{
			"id": "combat_heavy",
			"title": "Combat-Heavy Route",
			"nodes": [
				{"type": "battle", "stage": 0},
