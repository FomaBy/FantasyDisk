extends SceneTree

const ProgressionData := preload("res://scripts/progression_data.gd")

const REPORT_PATH := "res://build/route_economy_xp_model.md"
const START_XP_TO_NEXT := 5
const ATTRIBUTE_BUY_BASE_COST := 18
const ATTRIBUTE_BUY_STAGE_COST := 6
const ATTRIBUTE_REROLL_BASE_COST := 6
const ATTRIBUTE_REROLL_STAGE_COST := 2


func _init() -> void:
	var absolute_build_dir := ProjectSettings.globalize_path("res://build")
	DirAccess.make_dir_recursive_absolute(absolute_build_dir)
	var file := FileAccess.open(REPORT_PATH, FileAccess.WRITE)
	if file == null:
		push_error("Could not write route economy report: %s" % REPORT_PATH)
		quit(1)
		return
	file.store_string(build_report())
	file.close()
	print("Route economy report written: %s" % ProjectSettings.globalize_path(REPORT_PATH))
	quit(0)


static func build_report() -> String:
	var routes := _route_fixtures()
	var rows := []
	for route in routes:
		rows.append(_simulate_route(route))
	var lines := PackedStringArray()
	lines.append("# FantasyDisk Route Economy And XP Model")
	lines.append("")
	lines.append("Generated by `tools/route_economy_xp_model.gd` for SCRUM-188.")
	lines.append("")
	lines.append("This is a deterministic route-level model, not a replacement for live combat telemetry. It uses `ProgressionData.drop_class_rewards()`, `stage_scaled_cost()`, `shop_items()` and the live XP curve so the report follows the current game constants.")
	lines.append("")
	lines.append("## Route Results")
	lines.append("")
	lines.append("| Route | Nodes | Expected XP | Levels | XP Left | Expected Gold | Avg Shop Cost | Affordable Offers | Attr Buys | Rerolls | Buying Power |")
	lines.append("| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | --- |")
	for row in rows:
		lines.append("| %s | %d | %.1f | %d | %d/%d | %.1f | %.1f | %.1f | %.1f | %.1f | %s |" % [
			str(row["title"]),
			int(row["nodes"]),
			float(row["xp"]),
			int(row["levels"]),
			int(row["xp_left"]),
			int(row["xp_to_next"]),
			float(row["gold"]),
			float(row["avg_shop_cost"]),
			float(row["affordable_offers"]),
			float(row["attribute_buys"]),
			float(row["rerolls"]),
			str(row["buying_power"]),
		])
	lines.append("")
	lines.append("## Node Detail")
	lines.append("")
	for row in rows:
		lines.append("### %s" % str(row["title"]))
		lines.append("")
		lines.append("| Step | Node | Stage | XP | Gold | Shop Avg Cost | Note |")
		lines.append("| ---: | --- | ---: | ---: | ---: | ---: | --- |")
		for detail in row["details"]:
			lines.append("| %d | %s | %d | %.1f | %.1f | %.1f | %s |" % [
				int(detail["step"]),
				str(detail["node"]),
				int(detail["stage"]),
				float(detail["xp"]),
				float(detail["gold"]),
				float(detail["avg_shop_cost"]),
				str(detail["note"]),
			])
		lines.append("")
	lines.append("## XP Tempo Decision")
	lines.append("")
	lines.append(_tempo_decision(rows))
	lines.append("")
	lines.append("## Fixture Delta")
	lines.append("")
	lines.append(_fixture_delta())
	lines.append("")
	return "\n".join(lines)


